{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-forbidden-command.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "claude-turbo-workflow": {
      "source": {
        "source": "github",
        "repo": "tiennguyen-agilityio/claude-turbo-workflow"
      }
    }
  },
  "enabledPlugins": {
    "turbo-workflow@claude-turbo-workflow": true
  }
}
