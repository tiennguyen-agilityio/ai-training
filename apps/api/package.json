{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "pretest:e2e": "tsx test/reset-test-db.ts",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "migration:create": "mikro-orm migration:create",
    "migration:up": "mikro-orm migration:up",
    "migration:down": "mikro-orm migration:down",
    "seeder:create": "mikro-orm seeder:create",
    "seeder:run": "mikro-orm seeder:run",
    "docker:dev": "docker compose --env-file .env.docker -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose --env-file .env.docker -f docker-compose.yml -f docker-compose.dev.yml down",
    "docker:prod": "docker compose --env-file .env.docker -f docker-compose.yml up -d --build",
    "docker:prod:down": "docker compose --env-file .env.docker -f docker-compose.yml down"
  },
  "dependencies": {
    "@clerk/express": "^2.1.61",
    "@mikro-orm/core": "^7.2.1",
    "@mikro-orm/decorators": "^7.2.1",
    "@mikro-orm/migrations": "^7.2.1",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.1",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/observe": "^0.3.2",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@repo/constants": "workspace:*",
    "@repo/schemas": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "slugify": "^1.6.9",
    "svix": "^1.99.1",
    "uuid": "^11.1.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.2.1",
    "@mikro-orm/seeder": "^7.2.1",
    "@nestjs/cli": "^12.0.7",
    "@nestjs/schematics": "^12.0.5",
    "@nestjs/testing": "^12.1.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@standard-schema/spec": "^1.1.0",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.0",
    "@types/node": "catalog:",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "mikro-orm": {
    "configPaths": [
      "./src/configs/mikro-orm.config.ts",
      "./dist/configs/mikro-orm.config.js"
    ]
  },
  "prettier": "@repo/prettier-config"
}
